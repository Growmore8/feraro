# Copy to gateway/.env and fill in. .env is git-ignored; never commit keys.
# Real environment variables override anything in this file.

# Twelve Data — primary for FX (EURUSD, GBPUSD, AUDUSD, NZDUSD) and metals
# (XAUUSD, XAGUSD). https://twelvedata.com/account/api-keys
TWELVEDATA_API_KEY=
# Symbols one WebSocket connection may stream on your plan. Tradeable
# instruments are subscribed first; the rest are logged as not subscribed.
TWELVEDATA_MAX_SYMBOLS=8

# Finnhub — backup for FX (via OANDA) and crypto. https://finnhub.io/dashboard
FINNHUB_API_KEY=
FINNHUB_MAX_SYMBOLS=50

# Binance and Kraken need no key and always run.

# Journal and scheduling (optional).
# FERARO_SEGMENT_BYTES=8388608
# FERARO_SYNC_MS=200
# FERARO_ROLLOVER_HOUR=22
